{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "tasks.max": "1",
  "database.hostname": "postgres",
  "database.port": "5432",
  "database.user": "ecommerce_cdc",
  "database.password": "${env:CDC_POSTGRES_PASSWORD}",
  "database.dbname": "${env:POSTGRES_DB}",
  "topic.prefix": "ecommerce",
  "plugin.name": "pgoutput",
  "slot.name": "ecommerce_cdc_local",
  "slot.drop.on.stop": "false",
  "publication.name": "ecommerce_cdc_publication",
  "publication.autocreate.mode": "disabled",
  "schema.include.list": "customer_app,cdc_control",
  "table.include.list": "customer_app.app_users,customer_app.user_addresses,customer_app.shops,customer_app.categories,customer_app.products,customer_app.product_variants,customer_app.vouchers,customer_app.orders,customer_app.order_items,customer_app.order_vouchers,customer_app.payments,customer_app.shipments,cdc_control.debezium_heartbeat",
  "column.exclude.list": "customer_app.app_users.password_hash",
  "snapshot.mode": "initial",
  "provide.transaction.metadata": "true",
  "heartbeat.interval.ms": "10000",
  "heartbeat.action.query": "INSERT INTO cdc_control.debezium_heartbeat (id, last_seen_at) VALUES (1, clock_timestamp()) ON CONFLICT (id) DO UPDATE SET last_seen_at = EXCLUDED.last_seen_at",
  "topic.heartbeat.name": "ecommerce.heartbeat.v1",
  "topic.transaction": "transaction.v1",
  "tombstones.on.delete": "false",
  "decimal.handling.mode": "string",
  "binary.handling.mode": "base64",
  "transforms": "routecustomer,routecatalog,routepromotion,routesales,routepayment,routeshipping,routeheartbeat",
  "transforms.routecustomer.type": "io.debezium.transforms.ByLogicalTableRouter",
  "transforms.routecustomer.topic.regex": "ecommerce\\.customer_app\\.(app_users|user_addresses)",
  "transforms.routecustomer.topic.replacement": "ecommerce.domain.customer",
  "transforms.routecustomer.key.enforce.uniqueness": "true",
  "transforms.routecatalog.type": "io.debezium.transforms.ByLogicalTableRouter",
  "transforms.routecatalog.topic.regex": "ecommerce\\.customer_app\\.(shops|categories|products|product_variants)",
  "transforms.routecatalog.topic.replacement": "ecommerce.domain.catalog",
  "transforms.routecatalog.key.enforce.uniqueness": "true",
  "transforms.routepromotion.type": "io.debezium.transforms.ByLogicalTableRouter",
  "transforms.routepromotion.topic.regex": "ecommerce\\.customer_app\\.vouchers",
  "transforms.routepromotion.topic.replacement": "ecommerce.domain.promotion",
  "transforms.routepromotion.key.enforce.uniqueness": "true",
  "transforms.routesales.type": "io.debezium.transforms.ByLogicalTableRouter",
  "transforms.routesales.topic.regex": "ecommerce\\.customer_app\\.(orders|order_items|order_vouchers)",
  "transforms.routesales.topic.replacement": "ecommerce.domain.sales",
  "transforms.routesales.key.enforce.uniqueness": "true",
  "transforms.routepayment.type": "io.debezium.transforms.ByLogicalTableRouter",
  "transforms.routepayment.topic.regex": "ecommerce\\.customer_app\\.payments",
  "transforms.routepayment.topic.replacement": "ecommerce.domain.payment",
  "transforms.routepayment.key.enforce.uniqueness": "true",
  "transforms.routeshipping.type": "io.debezium.transforms.ByLogicalTableRouter",
  "transforms.routeshipping.topic.regex": "ecommerce\\.customer_app\\.shipments",
  "transforms.routeshipping.topic.replacement": "ecommerce.domain.shipping",
  "transforms.routeshipping.key.enforce.uniqueness": "true",
  "transforms.routeheartbeat.type": "io.debezium.transforms.ByLogicalTableRouter",
  "transforms.routeheartbeat.topic.regex": "ecommerce\\.cdc_control\\.debezium_heartbeat",
  "transforms.routeheartbeat.topic.replacement": "ecommerce.heartbeat.v1",
  "transforms.routeheartbeat.key.enforce.uniqueness": "true"
}
