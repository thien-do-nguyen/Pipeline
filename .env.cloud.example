# ==============================================================================
# 1. REQUIRED: AZURE POSTGRESQL (OLTP SOURCE)
# ==============================================================================
# Connection details for Azure Database for PostgreSQL Flexible Server.
POSTGRES_HOST=<server-name>.postgres.database.azure.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=<azure-postgres-user>

# ==============================================================================
# 2. REQUIRED: DATABRICKS & UNITY CATALOG (MEDALLION LAKEHOUSE)
# ==============================================================================
# Databricks CLI authentication profile and Asset Bundle target.
DATABRICKS_PROFILE=ecommerce-dev
DATABRICKS_TARGET=dev
DATABRICKS_RUN_PRINCIPAL=<databricks-user-or-service-principal>
DATABRICKS_SECRET_SCOPE=ecommerce-pipeline

# Unity Catalog storage & catalog namespace configurations.
DATABRICKS_UC_CATALOG=dbw_tk1_student_dev_sea
DATABRICKS_UC_STORAGE_CREDENTIAL=<unity-catalog-storage-credential>
DATABRICKS_AZURE_STORAGE_ACCOUNT=<storage-account-name>
DATABRICKS_AZURE_STORAGE_CONTAINER=lakehouse

# Target schemas for Medallion architecture in Unity Catalog.
DATABRICKS_BRONZE_SCHEMA=ecommerce_bronze
DATABRICKS_SILVER_SCHEMA=ecommerce_silver
DATABRICKS_GOLD_SCHEMA=ecommerce_gold

# ==============================================================================
# 3. ONE-TIME SETUP PASSWORDS (Bootstrap & Infrastructure Provisioning)
# ==============================================================================
# Required only when executing "make cdc-cloud-pg-bootstrap" from your local machine.
# On Databricks, secrets are retrieved from DATABRICKS_SECRET_SCOPE directly.
POSTGRES_PASSWORD=<azure-postgres-admin-password>
CDC_POSTGRES_PASSWORD=<dedicated-ecommerce-cdc-role-password>

# ==============================================================================
# 4. OPTIONAL: AZURE CDC INFRASTRUCTURE (Terraform / ACI / Event Hubs)
# ==============================================================================
# Fallback defaults exist in Makefile. Override only if using a custom Azure subscription or RG.
AZURE_SUBSCRIPTION_ID=<azure-subscription-id>
AZURE_CDC_RESOURCE_GROUP=rg-tk1-student-cdc-dev
AZURE_CDC_NAME_PREFIX=tk1-ecommerce-cdc-dev
