# ==============================================================================
# 1. REQUIRED LOCAL RUNTIME CONFIGURATION
# ==============================================================================
# Mandatory variables for local PostgreSQL, Batch jobs, and CDC streaming runtime.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
CDC_POSTGRES_PASSWORD=cdc-local-only

# ==============================================================================
# 2. OPTIONAL: CUSTOM PORT BINDINGS (Fallbacks exist in docker-compose)
# ==============================================================================
# Modify only if you have conflicting local services running on these ports.
KAFKA_PORT=29092
KAFKA_CONNECT_PORT=8083
AIRFLOW_PORT=8080
AIRFLOW_PARALLELISM=4

# ==============================================================================
# 3. OPTIONAL: AIRFLOW SCHEDULING & TIMEOUTS
# ==============================================================================
# Leave schedule empty for manual trigger only. Set cron (e.g. "0 * * * *") for automation.
AIRFLOW_BATCH_SCHEDULE=
AIRFLOW_CLOUD_BATCH_SCHEDULE=
AIRFLOW_BATCH_DAG_TIMEOUT_SECONDS=14400

# ==============================================================================
# 4. OPTIONAL: DATABRICKS HYBRID ORCHESTRATION
# ==============================================================================
# Required only if local Airflow triggers a deployed Databricks batch job.
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_JOB_ID=
DATABRICKS_POLL_SECONDS=5
DATABRICKS_HTTP_TIMEOUT_SECONDS=15
DATABRICKS_RUN_TIMEOUT_SECONDS=7200

# ==============================================================================
# 5. OPTIONAL: AZURE CDC DEPLOYMENT (Terraform / ACI)
# ==============================================================================
# Used by Makefile targets when managing cloud CDC infrastructure.
AZURE_SUBSCRIPTION_ID=
AZURE_CDC_RESOURCE_GROUP=rg-tk1-student-cdc-dev
AZURE_CDC_NAME_PREFIX=tk1-ecommerce-cdc-dev
